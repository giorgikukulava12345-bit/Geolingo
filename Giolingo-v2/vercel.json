{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/update.html", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}, {"key": "Service-Worker-Allowed", "value": "/"}]}
  ]
}
